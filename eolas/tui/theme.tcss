/* Eolas/FMSAT terminal theme. */

$forest: #1f4d3a;
$forest-dark: #15372a;
$forest-soft: #2f6651;
$gold: #d1aa5b;
$cream: #f1ead9;
$stone: #b8b2a4;
$ink: #19211d;
$muted: #839087;
$danger: #b85c52;

Screen {
    background: $forest-dark;
    color: $cream;
}

Header {
    background: $forest;
    color: $cream;
    height: 3;
}

Footer {
    background: $ink;
    color: $stone;
}

#body {
    height: 1fr;
}

#navigation {
    width: 28;
    min-width: 24;
    background: $forest;
    border-right: solid $gold;
    padding: 1 1;
}

#brand {
    color: $gold;
    text-style: bold;
    text-align: center;
    height: 2;
}

#tagline {
    color: $cream;
    text-align: center;
    margin-bottom: 1;
}

.navButton {
    width: 100%;
    min-width: 0;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $forest;
    color: $cream;
    border: none;
    text-align: left;
    content-align: left middle;
}

.navButton:hover,
.navButton:focus {
    background: $forest-soft;
    color: $gold;
    text-style: bold;
}

#navHint {
    color: $muted;
    margin-top: 1;
    padding: 1;
    border-top: solid $forest-soft;
}

#workspace {
    width: 1fr;
    padding: 1 2 2 2;
    background: $forest-dark;
}

#pageTitle {
    color: $gold;
    text-style: bold;
    height: 2;
}

#pageSubtitle {
    color: $stone;
    margin-bottom: 1;
}

#summaryCards {
    height: 7;
    margin-bottom: 1;
}

.summaryCard {
    width: 1fr;
    margin-right: 1;
    padding: 1;
    background: $forest;
    border: round $forest-soft;
    color: $cream;
    text-align: center;
}

#readinessLabel {
    color: $stone;
    text-style: bold;
    margin-top: 1;
}

#readiness {
    width: 100%;
    margin-bottom: 1;
}

#records {
    height: auto;
    min-height: 10;
    max-height: 18;
    background: $ink;
    border: round $forest-soft;
}

#records > .datatable--header {
    background: $forest;
    color: $gold;
    text-style: bold;
}

#records > .datatable--cursor {
    background: $forest-soft;
    color: $cream;
}

#detail {
    margin-top: 1;
    padding: 1 2;
    background: $forest;
    border-left: thick $gold;
    color: $cream;
}

#captureForm {
    display: none;
    max-width: 76;
    padding: 1 2;
    background: $forest;
    border: round $forest-soft;
}

#captureTitle {
    color: $gold;
    text-style: bold;
    margin-bottom: 1;
}

Input {
    margin-bottom: 1;
    border: tall $forest-soft;
}

Input:focus {
    border: tall $gold;
}

#validation {
    height: 2;
    color: $gold;
}

#validation.error {
    color: $danger;
    text-style: bold;
}

#savePreview {
    width: 24;
    background: $gold;
    color: $ink;
    border: none;
}

ConfirmationModal {
    align: center middle;
    background: rgba(10, 18, 14, 0.75);
}

#dialog {
    width: 58;
    height: auto;
    background: $forest;
    border: round $gold;
    padding: 1 2;
}

#dialogTitle {
    color: $gold;
    text-style: bold;
    margin-bottom: 1;
}

#dialogBody {
    color: $cream;
    margin-bottom: 1;
}

#dialogButtons {
    height: 3;
    align-horizontal: right;
}

#dialogButtons Button {
    margin-left: 1;
}


Screen.compact #navigation {
    width: 21;
    min-width: 20;
}

Screen.compact #tagline,
Screen.compact #navHint {
    display: none;
}

Screen.compact #workspace {
    padding: 1;
}

Screen.compact #summaryCards {
    height: 9;
}

Screen.narrow #navigation {
    width: 18;
    min-width: 18;
}

Screen.narrow .navButton {
    padding: 0;
}

Screen.narrow #summaryCards {
    display: none;
}


#clannCreateView {
    display: none;
    width: 100%;
    max-width: 100;
    padding: 1 2;
    background: $forest;
    border: round $forest-soft;
}

#clannCreateTitle,
.formSectionTitle {
    color: $gold;
    text-style: bold;
    margin-bottom: 1;
}

.formIntro {
    color: $stone;
    margin-bottom: 1;
}

.twoColumnFields {
    height: auto;
}

.twoColumnFields > Vertical {
    width: 1fr;
    margin-right: 1;
}

#personOptions {
    height: 3;
    margin-bottom: 1;
}

#personOptions Checkbox {
    width: 1fr;
}

.formButtons {
    height: 3;
    margin-bottom: 1;
}

.formButtons Button {
    margin-right: 1;
}

#clannPeople {
    height: 10;
    margin-bottom: 1;
    background: $ink;
    border: round $forest-soft;
}

#personValidation,
#clannValidation {
    min-height: 2;
    color: $gold;
}

#personValidation.error,
#clannValidation.error {
    color: $danger;
    text-style: bold;
}

ClannCreateConfirmScreen {
    align: center middle;
    background: rgba(10, 18, 14, 0.75);
}

#clannConfirmDialog {
    width: 72;
    height: auto;
    max-height: 80%;
    background: $forest;
    border: round $gold;
    padding: 1 2;
}

#clannConfirmSummary {
    margin: 1 0;
    padding: 1;
    background: $ink;
    color: $cream;
}

Screen.compact .twoColumnFields {
    layout: vertical;
}

Screen.compact .twoColumnFields > Vertical {
    width: 100%;
}
